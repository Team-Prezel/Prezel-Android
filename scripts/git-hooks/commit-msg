#!/bin/sh
set -e

COMMIT_MSG_FILE="$1"
COMMIT_MSG="$(cat "$COMMIT_MSG_FILE")"

echo ""
echo "───────── [commit-msg] 시작 ─────────"
echo "커밋 메시지 규칙 확인 중..."

# Allow merge/revert commits
case "$COMMIT_MSG" in
  Merge*) exit 0 ;;
  Revert*) exit 0 ;;
  fixup!*) exit 0 ;;
  squash!*) exit 0 ;;
  *) ;;
esac

# Conventional Commits pattern
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?(!)?: .+'

if ! printf "%s" "$COMMIT_MSG" | grep -Eq "$PATTERN"; then
  echo "[commit-msg] 실패: 커밋 메시지 형식 오류" >&2
  echo "Expected: type(scope)!: subject (scope optional)" >&2
  echo "Example: feat: add login flow | fix(api): handle timeout" >&2
  exit 1
fi

echo "[commit-msg] 완료"
